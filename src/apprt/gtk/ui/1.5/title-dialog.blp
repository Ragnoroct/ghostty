using Gtk 4.0;
using Adw 1;

template $GhosttyTitleDialog: Adw.AlertDialog {
  body: _("Leave blank to restore the default title.");

  responses [
    cancel: _("Cancel"),
    ok: _("OK") suggested,
  ]

  default-response: "ok";
  focus-widget: entry;

  extra-child: Box {
    orientation: vertical;
    spacing: 12;

    Entry entry {
      activates-default: true;
    }

    CheckButton status_updates {
      visible: false;
      label: _("Allow live status updates");
      tooltip-text: _("Keep this name and show activity, attention, and task progress.");
    }
  };
}
